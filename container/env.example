# .env.example
# Copy to .env and adjust.  All values shown are the defaults.
#
# Build-time flags (--build-arg / docker-bake.hcl)
# ─────────────────────────────────────────────────
# These are baked into the image as ENV vars, so you can also override them
# at runtime via `docker run -e` or a compose `environment:` block.
# The image will only contain extensions that were enabled at BUILD time.
# Disabling one here at runtime when it was enabled at build time is safe
# (the library files exist but won't be loaded).  The reverse is NOT safe.
#
ENABLE_PGVECTOR=true
ENABLE_PGVECTORSCALE=true
ENABLE_PGLATER=true
ENABLE_PGMQ=true
ENABLE_ANON=true
ENABLE_SAFEUPDATE=true
ENABLE_TIMESCALEDB=true
ENABLE_POSTGIS=true
ENABLE_PGCRON=true
ENABLE_PGAUDIT=true
ENABLE_PGSQUEEZE=true
ENABLE_PGROONGA=true
ENABLE_PGBACKREST=true

# ── PostgreSQL core ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
PGDATA=/var/lib/postgresql/18/docker

# ── pg_cron ───────────────────────────────────────────────────────────────────
# The database pg_cron's background worker connects to for reading job
# definitions. Must match the database where you run CREATE EXTENSION pg_cron.
# Defaults to 'postgres' (pg_cron's own default). Only set this if you need
# pg_cron jobs in a non-standard database.
#PGCRON_DATABASE=postgres

# ── pg_later ──────────────────────────────────────────────────────────────────
# pg_later needs a libpq connection string to the database where pgmq is
# installed. The entrypoint auto-constructs this from POSTGRES_* vars, so you
# normally do NOT need to set this.
# Only set DATABASE_URL explicitly if:
#   - pg_later should connect to a different host (e.g. a remote primary)
#   - You need SSL params or other libpq options in the connection string
#DATABASE_URL=postgresql://postgres:changeme@localhost:5432/postgres
#
# These are used when auto-constructing DATABASE_URL (ignored if DATABASE_URL
# is set explicitly):
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432

# ── TLS (optional) ────────────────────────────────────────────────────────────
# Set SERVER_CRT and SERVER_KEY together to turn ssl on. keys/generate-certs.sh
# prints ready-to-paste values. ROOT_CA_CRT adds ssl_ca_file for client certs.
#SERVER_CRT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#SERVER_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#ROOT_CA_CRT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── pgBackRest — local disk (default) ────────────────────────────────────────
# These use PGBR_*: pgBackRest reads every PGBACKREST_* variable as one of its
# own options. The old PGBACKREST_* names are still accepted.
PGBR_RETENTION_FULL=13
# Full backup schedule (cron syntax)
PGBR_CRON_FULL=5 2 * * 0
# Incremental backup schedule (cron syntax)
PGBR_CRON_INCR=5 2 * * 1-6

# ── pgBackRest — encryption (required) ───────────────────────────────────────
# Backups are encrypted with aes-256-cbc. The container refuses to set up
# backups without a passphrase. Keep a copy somewhere safe: a lost passphrase
# means the backups cannot be restored.
#   openssl rand -base64 48
PGBR_CIPHER_PASS=
# Only for throwaway setups: store backups in the clear.
#PGBR_ALLOW_UNENCRYPTED=false

# ── pgBackRest — S3 / object storage (optional) ──────────────────────────────
# Setting PGBR_S3_ENDPOINT switches pgBackRest from local-disk to S3 mode.
# All four variables below are required when S3 mode is active.
#PGBR_S3_ENDPOINT=s3.us-east-1.amazonaws.com
#PGBR_S3_REGION=us-east-1
#PGBR_S3_BUCKET=my-pg-backups
#PGBR_S3_KEY=AKIAIOSFODNN7EXAMPLE
#PGBR_S3_KEY_SECRET=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Verify the endpoint's TLS certificate. Set to n only for self-signed endpoints.
#PGBR_S3_VERIFY_TLS=y

# ── Advanced: disable auto-management ────────────────────────────────────────
# Set to 0 to bring your own config / cron file.
#PGBR_MANAGE_CONFIG=1
#PGBR_MANAGE_CRON=1
#PGBR_CRON_FILE=/etc/cron.d/pgbackrest
#PGBACKREST_CONFIG=/etc/pgbackrest/pgbackrest.conf
