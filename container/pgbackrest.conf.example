[global]
spool-path=/pgbackrest/spool
start-fast=y
delta=y
expire-auto=y
compress-type=zst
compress-level=6
log-level-console=info
log-level-file=detail
repo1-retention-full=13
repo1-path=/pgbackrest/repo

# Local repo mode
archive-async=n
process-max=4
repo1-type=posix

#[global]
## S3 repo mode (uncomment and fill values)
#archive-async=y
#process-max=2
#repo1-type=s3
#repo1-s3-uri-style=path
#repo1-s3-region=us-east-1
#repo1-s3-endpoint=<s3-endpoint>
#repo1-s3-bucket=<bucket>
#repo1-s3-key=<access-key>
#repo1-s3-key-secret=<secret-key>
#repo1-s3-verify-ssl=n

[default]
pg1-path=/var/lib/postgresql/18/docker
